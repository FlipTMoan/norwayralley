/* Retro HUD: the JS game's amber-on-dark look (legacy-js/src/style.css #hud, #turnBox), bigger turn box as of 2026-11-15. */
/* The JS game used Press Start 2P; drop a .ttf under a Resources/Fonts folder and add `-unity-font-definition: resource('Fonts/PressStart2P');` to .hud to get it back. */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(255, 196, 64); }
.top { position: absolute; top: 12px; left: 16px; flex-direction: row; }
.clock { font-size: 28px; }
.penalty { font-size: 18px; color: rgb(255, 80, 60); margin-left: 12px; }
.dist { font-size: 14px; margin-left: 20px; margin-top: 10px; }
.turnBox { position: absolute; top: 20px; right: 20px; flex-direction: row; align-items: center; padding: 10px 18px; background-color: rgba(0, 0, 0, 0.55); border-radius: 8px; }
.arrow { width: 76px; height: 76px; background-image: resource('UI/arrow'); -unity-background-scale-mode: scale-to-fit; }
.noteDist { font-size: 36px; margin-left: 14px; }
.noteKind { font-size: 13px; margin-left: 14px; }
.bottom { position: absolute; bottom: 16px; left: 16px; right: 16px; flex-direction: row; align-items: flex-end; }
.dial { flex-direction: row; align-items: flex-end; }
.speed { font-size: 48px; }
.unit { font-size: 12px; margin-left: 6px; margin-bottom: 8px; }
.gear { font-size: 32px; margin-left: 24px; color: rgb(255, 255, 255); }
.rpm { width: 220px; height: 12px; margin-left: 24px; margin-bottom: 10px; background-color: rgba(0, 0, 0, 0.5); }
.rpmBar { height: 100%; width: 0%; background-color: rgb(255, 196, 64); }
.rpmBar.redline { background-color: rgb(255, 60, 40); }
.surface { font-size: 12px; margin-left: 24px; margin-bottom: 8px; }
.damage { width: 120px; height: 8px; margin-left: auto; margin-bottom: 10px; background-color: rgba(0, 0, 0, 0.5); }
.damageBar { height: 100%; width: 0%; background-color: rgb(255, 60, 40); }
.status { position: absolute; bottom: 60px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 14px; color: rgb(255, 255, 255); }

/* Start screen (index.html #start) and the friends panel (index.html #friends). */
.startScreen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.55); }
.title { font-size: 40px; color: rgb(255, 196, 64); margin-bottom: 16px; }
.startInfo { font-size: 12px; color: rgb(255, 255, 255); margin-bottom: 20px; }
.bigButton { font-size: 22px; padding: 14px 32px; background-color: rgb(255, 196, 64); color: rgb(20, 20, 20); border-width: 0; border-radius: 6px; }
.friends { margin-top: 28px; padding: 14px 18px; background-color: rgba(0, 0, 0, 0.5); border-radius: 8px; align-items: center; width: 420px; }
.friendsTitle { font-size: 12px; color: rgb(255, 196, 64); margin-bottom: 10px; }
.smallButton { font-size: 12px; padding: 8px 14px; background-color: rgb(255, 196, 64); color: rgb(20, 20, 20); border-width: 0; border-radius: 4px; margin: 4px; }
.row { flex-direction: row; align-items: center; }
.roomCode { width: 120px; font-size: 16px; }
.roomStatus { font-size: 11px; color: rgb(255, 255, 255); margin-top: 6px; }
.hint { font-size: 9px; color: rgb(200, 200, 200); margin-top: 8px; white-space: normal; -unity-text-align: middle-center; }
.credits { position: absolute; bottom: 10px; font-size: 8px; color: rgb(200, 200, 200); white-space: normal; -unity-text-align: middle-center; padding: 0 24px; }

/* In-game log window (LogWindow.cs): F2 or the LOG button. Drawn after the start screen so it stays on top. */
.logButton { position: absolute; top: 12px; left: 230px; font-size: 10px; padding: 4px 10px; background-color: rgba(0, 0, 0, 0.55); color: rgb(255, 196, 64); border-width: 1px; border-color: rgb(255, 196, 64); border-radius: 4px; }
.logButton.on { background-color: rgb(255, 196, 64); color: rgb(20, 20, 20); }
.logWindow { position: absolute; left: 12px; top: 52px; width: 66%; max-width: 980px; height: 52%; background-color: rgba(8, 10, 14, 0.88); border-width: 1px; border-color: rgba(255, 196, 64, 0.6); border-radius: 6px; padding: 6px; }
.logBar { flex-direction: row; align-items: center; margin-bottom: 4px; flex-shrink: 0; }
.logTitle { font-size: 11px; color: rgb(255, 196, 64); margin-right: 10px; }
.logSpacer { flex-grow: 1; }
.logChip { font-size: 9px; padding: 3px 8px; margin: 0 2px; background-color: rgba(255, 255, 255, 0.08); color: rgb(220, 220, 220); border-width: 0; border-radius: 3px; }
.logChip.on { background-color: rgb(255, 196, 64); color: rgb(20, 20, 20); }
.logList { flex-grow: 1; }
.logLine { font-size: 10px; height: 15px; padding: 0 4px; color: rgb(205, 210, 215); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.logLine.tile { color: rgb(120, 200, 255); }
.logLine.overlay { color: rgb(150, 230, 150); }
.logLine.cache { color: rgb(170, 170, 190); }
.logLine.warn { color: rgb(255, 196, 64); }
.logLine.err { color: rgb(255, 90, 70); }

/* Start-screen options, controls list, cache line (index.html .start-options / .start-controls / .start-cache). */
.startOptions { margin-top: 14px; }
/* Car chooser on the start screen (HudController.SetCars): one card per car, the chosen one outlined. */
.carCards { flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 1000px; margin-bottom: 4px; }
.carCard { width: 112px; margin: 2px; padding: 3px; background-color: rgba(0, 0, 0, 0.55); border-width: 2px; border-color: rgba(255, 196, 64, 0.25); border-radius: 6px; align-items: center; }
.carCard:hover { border-color: rgba(255, 196, 64, 0.6); }
.carCard.selected { border-color: rgb(255, 196, 64); background-color: rgba(60, 45, 10, 0.75); }
.carPicture { width: 104px; height: 58px; -unity-background-scale-mode: scale-to-fit; border-radius: 3px; }
.carName { font-size: 10px; color: rgb(255, 196, 64); margin-top: 3px; -unity-text-align: middle-center; white-space: normal; }
.carStats { font-size: 8px; color: rgb(220, 220, 220); -unity-text-align: middle-center; white-space: normal; }
.carHint { font-size: 9px; color: rgb(200, 200, 200); margin-bottom: 12px; }
.toggleButton { font-size: 11px; padding: 7px 12px; margin: 3px; background-color: rgba(0, 0, 0, 0.55); color: rgb(255, 196, 64); border-width: 1px; border-color: rgb(255, 196, 64); border-radius: 4px; }
.startControls { font-size: 9px; color: rgb(220, 220, 220); margin-top: 12px; white-space: normal; -unity-text-align: middle-center; max-width: 760px; }
.cacheRow { margin-top: 10px; }
.cacheInfo { font-size: 9px; color: rgb(200, 200, 200); margin-right: 6px; }
/* Debug panel (F10 / F3, or three quick taps on the speed): main.js debug window. */
.debugPanel { position: absolute; right: 12px; top: 120px; width: 340px; padding: 8px 10px; font-size: 10px; color: rgb(210, 230, 210); background-color: rgba(8, 10, 14, 0.85); border-radius: 6px; white-space: normal; display: none; }
/* Help line at the bottom (desktop), touch buttons (phones and narrow screens). */
.helpLine { position: absolute; bottom: 2px; left: 0; right: 0; font-size: 8px; color: rgba(255, 255, 255, 0.55); -unity-text-align: middle-center; }
.touchControls { position: absolute; left: 12px; right: 12px; bottom: 70px; flex-direction: row; justify-content: space-between; display: none; }
.touchSide { flex-direction: row; }
.touchButton { width: 84px; height: 84px; margin: 6px; font-size: 16px; background-color: rgba(0, 0, 0, 0.45); color: rgb(255, 196, 64); border-width: 2px; border-color: rgba(255, 196, 64, 0.7); border-radius: 42px; }
.touchButton.held { background-color: rgba(255, 196, 64, 0.55); color: rgb(20, 20, 20); }
.mapButton { left: 290px; }
/* Help screen (H / F1, the ? buttons): over everything, scrolls on small screens; touch-sized buttons. */
.helpButton { left: 350px; min-width: 34px; -unity-text-align: middle-center; }
.helpOverlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.6); display: none; }
.helpPanel { width: 92%; max-width: 860px; max-height: 90%; padding: 10px 14px; background-color: rgba(8, 10, 14, 0.94); border-width: 1px; border-color: rgba(255, 196, 64, 0.7); border-radius: 6px; }
.helpBar { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 6px; }
.helpTitle { font-size: 16px; color: rgb(255, 196, 64); margin-right: 12px; }
.helpHint { font-size: 10px; color: rgb(170, 170, 170); }
.helpScroll { flex-grow: 1; flex-shrink: 1; }
.helpHead { font-size: 12px; color: rgb(255, 196, 64); margin-top: 10px; margin-bottom: 3px; }
.helpText { font-size: 11px; color: rgb(225, 225, 225); white-space: normal; }
.helpRow { flex-direction: row; }
.helpCell { font-size: 11px; color: rgb(225, 225, 225); width: 22%; padding: 1px 0; }
.helpCellHead { color: rgb(255, 196, 64); font-size: 10px; }
.helpCol0 { width: 34%; }
.helpKey.helpCol0 { width: 22%; color: rgb(255, 196, 64); }
.helpKey.helpCol1 { width: 78%; white-space: normal; }
