<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Hud.uss" />
  <ui:VisualElement name="hud" class="hud">
    <ui:VisualElement class="top">
      <ui:Label name="clock" text="0:00.00" class="clock" />
      <ui:Label name="penalty" text="" class="penalty" />
      <ui:Label name="distLeft" text="" class="dist" />
    </ui:VisualElement>
    <ui:VisualElement name="turnBox" class="turnBox">
      <ui:VisualElement name="arrow" class="arrow" />
      <ui:Label name="noteDist" text="300" class="noteDist" />
      <ui:Label name="noteKind" text="EASY LEFT" class="noteKind" />
    </ui:VisualElement>
    <ui:VisualElement class="bottom">
      <ui:VisualElement class="dial">
        <ui:Label name="speed" text="0" class="speed" />
        <ui:Label text="km/h" class="unit" />
        <ui:Label name="gear" text="1" class="gear" />
        <ui:VisualElement class="rpm"><ui:VisualElement name="rpmBar" class="rpmBar" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="surface" text="GRAVEL" class="surface" />
      <ui:VisualElement class="damage"><ui:VisualElement name="damageBar" class="damageBar" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="status" text="" class="status" />
    <ui:VisualElement name="startScreen" class="startScreen">
      <ui:Label text="RETRO NORWAY RALLY" class="title" />
      <ui:Label name="startInfo" text="" class="startInfo" />
      <ui:Button name="startButton" text="START ENGINE" class="bigButton" />
      <ui:VisualElement class="row startOptions">
        <ui:Button name="gearboxBtn" text="GEARBOX: AUTOMATIC" class="toggleButton" />
        <ui:Button name="slideBtn" text="SLIDING: 0 MINIMAL" class="toggleButton" />
        <ui:Button name="mapBtn" text="PICK A ROUTE ON THE MAP" class="toggleButton" />
      </ui:VisualElement>
      <ui:Label text="WASD / arrows drive · SPACE jump · SHIFT handbrake · Q/E gear · G auto/manual · R restart · N new stage · ESC menu · 1/2/3 or C camera · M mute · F10 debug · F2 log" class="startControls" />
      <ui:VisualElement name="friends" class="friends">
        <ui:Label text="DRIVE WITH FRIENDS" class="friendsTitle" />
        <ui:Button name="hostButton" text="HOST A ROOM" class="smallButton" />
        <ui:VisualElement class="row">
          <ui:TextField name="roomCode" max-length="6" class="roomCode" />
          <ui:Button name="joinButton" text="JOIN" class="smallButton" />
        </ui:VisualElement>
        <ui:Label name="roomStatus" text="" class="roomStatus" />
        <ui:Label text="Phones cannot link over Bluetooth from a web page; rooms go through the internet (4-letter code)." class="hint" />
      </ui:VisualElement>
      <ui:VisualElement class="row cacheRow">
        <ui:Label name="cacheInfo" text="Local cache: …" class="cacheInfo" />
        <ui:Button name="cacheClear" text="CLEAR" class="smallButton" />
      </ui:VisualElement>
      <ui:Label text="Made by Filip Tobias Moan © 2026 · terrain © Kartverket (CC BY 4.0) · SR16 © NIBIO (NLOD) · © OpenStreetMap contributors (ODbL) · Statens vegvesen (NLOD) · geoBoundaries (CC BY 4.0)" class="credits" />
    </ui:VisualElement>
    <ui:Label name="debugPanel" text="" class="debugPanel" />
    <ui:Label name="helpLine" text="WASD drive · SPACE jump · SHIFT drift · Q/E gear · G auto/manual · R restart · N new stage · ESC menu · 1/2/3 C camera · F10 debug · F2 log · M mute" class="helpLine" />
    <ui:VisualElement name="touchControls" class="touchControls">
      <ui:VisualElement class="touchSide">
        <ui:Button name="touchLeft" text="◀" class="touchButton" />
        <ui:Button name="touchRight" text="▶" class="touchButton" />
      </ui:VisualElement>
      <ui:VisualElement class="touchSide">
        <ui:Button name="touchBrake" text="BRAKE" class="touchButton" />
        <ui:Button name="touchThrottle" text="GAS" class="touchButton" />
        <ui:Button name="touchDrift" text="DRIFT" class="touchButton" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button name="mapButton" text="MAP" class="logButton mapButton" />
    <ui:Button name="logButton" text="LOG" class="logButton" />
    <ui:VisualElement name="logWindow" class="logWindow">
      <ui:VisualElement class="logBar">
        <ui:Label text="LOG" class="logTitle" />
        <ui:Button name="logAll" text="ALL" class="logChip on" />
        <ui:Button name="logTiles" text="TILES" class="logChip" />
        <ui:Button name="logOverlays" text="OVERLAYS" class="logChip" />
        <ui:Button name="logCache" text="CACHE" class="logChip" />
        <ui:Button name="logWarn" text="WARN" class="logChip" />
        <ui:VisualElement class="logSpacer" />
        <ui:Button name="logFollow" text="FOLLOW" class="logChip on" />
        <ui:Button name="logCopy" text="COPY" class="logChip" />
        <ui:Button name="logClose" text="X" class="logChip" />
      </ui:VisualElement>
      <ui:ListView name="logList" class="logList" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
