<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="Hud.uss" />
  <ui:VisualElement name="hud" class="hud">
    <ui:VisualElement class="top drivingHud" picking-mode="Ignore">
      <ui:Label name="clock" text="0:00.00" class="clock" />
      <ui:Label name="penalty" text="" class="penalty" />
      <ui:Label name="distLeft" text="" class="dist" />
    </ui:VisualElement>
    <ui:VisualElement name="turnBox" class="turnBox">
      <ui:Label name="noteDist" text="300" class="noteDist" />
      <ui:Label name="noteKind" text="EASY LEFT" class="noteKind" />
    </ui:VisualElement>
    <ui:VisualElement class="bottom drivingHud" picking-mode="Ignore">
      <ui:VisualElement class="dial">
        <ui:Label name="speed" text="0" class="speed" />
        <ui:Label text="km/h" class="unit" />
        <ui:Label name="gear" text="1" class="gear" />
        <ui:VisualElement class="rpm"><ui:VisualElement name="rpmBar" class="rpmBar" /></ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="surface" text="GRAVEL" class="surface" />
      <ui:VisualElement class="damage"><ui:VisualElement name="damageBar" class="damageBar" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="status" text="" class="status drivingHud" />
    <ui:VisualElement name="startScreen" class="startScreen">
      <ui:ScrollView name="startScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="startScroll">
        <ui:VisualElement name="startColumn" class="startColumn">
          <ui:VisualElement class="logo">
            <ui:Label text="GRAND TOUR" class="title" />
            <ui:Label text="N O R W A Y" class="titleSub" />
          </ui:VisualElement>
          <ui:VisualElement name="carCards" class="carCards" />
          <ui:Label name="carHint" text="CHOOSE YOUR CAR: click a card, or LEFT / RIGHT" class="carHint" />
          <ui:Button name="startButton" text="START ENGINE" class="bigButton" />
          <ui:Label name="startInfo" text="" class="startInfo" />
          <ui:VisualElement class="row startOptions">
            <ui:Button name="gearboxBtn" text="GEARBOX: AUTOMATIC" class="toggleButton" />
            <ui:Button name="slideBtn" text="SLIDING: 0 MINIMAL" class="toggleButton" />
            <ui:Button name="mapBtn" text="ROUTE MAP" class="toggleButton" />
            <ui:Button name="helpBtn" text="? HELP" class="toggleButton" />
          </ui:VisualElement>
          <ui:Label name="startControls" text="WASD / arrows drive · SPACE jump · SHIFT handbrake · Q/E gears · ESC this menu · H help" class="startControls" />
          <ui:VisualElement name="friends" class="friends">
            <ui:Label text="DRIVE WITH FRIENDS" class="friendsTitle" />
            <ui:VisualElement class="row friendsRow">
              <ui:Button name="hostButton" text="HOST A ROOM" class="smallButton" />
              <ui:Label text="or" class="friendsOr" />
              <ui:TextField name="roomCode" max-length="6" class="roomCode" />
              <ui:Button name="joinButton" text="JOIN" class="smallButton" />
            </ui:VisualElement>
            <ui:Label name="roomStatus" text="" class="roomStatus" />
          </ui:VisualElement>
          <ui:VisualElement class="startFooter">
            <ui:VisualElement class="row cacheRow">
              <ui:Label name="cacheInfo" text="Local cache: …" class="cacheInfo" />
              <ui:Button name="cacheClear" text="CLEAR" class="tinyButton" />
            </ui:VisualElement>
            <ui:Label text="Made by Filip Tobias Moan © 2026 · terrain and place names © Kartverket (CC BY 4.0) · forest SR16 © NIBIO (NLOD) · bioclimatic zones Artsdatabanken (NLOD) · © OpenStreetMap contributors (ODbL) · road data Statens vegvesen (NLOD) · routing OSRM · borders geoBoundaries (CC BY 4.0)" class="credits" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:ScrollView>
    </ui:VisualElement>
    <ui:Label name="debugPanel" text="" class="debugPanel" />
    <ui:Label name="helpLine" text="H help · WASD drive · SPACE jump · SHIFT drift · Q/E gear · G auto/manual · R restart · N new stage · ESC menu · 1/2/3 C camera · F10 debug · F2 log · M mute" class="helpLine drivingHud" />
    <ui:VisualElement name="touchControls" class="touchControls">
      <ui:VisualElement class="touchSide">
        <ui:Button name="touchLeft" text="◀" class="touchButton" />
        <ui:Button name="touchRight" text="▶" class="touchButton" />
      </ui:VisualElement>
      <ui:VisualElement class="touchSide">
        <ui:Button name="touchBrake" text="BRAKE" class="touchButton" />
        <ui:Button name="touchThrottle" text="GAS" class="touchButton" />
        <ui:Button name="touchDrift" text="DRIFT" class="touchButton" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="hudButtons" class="hudButtons" picking-mode="Ignore">
      <ui:Button name="menuButton" text="MENU" class="logButton drivingHud" />
      <ui:Button name="mapButton" text="MAP" class="logButton drivingHud" />
      <ui:Button name="helpButton" text="?" class="logButton helpButton drivingHud" />
      <ui:VisualElement name="logMini" class="logMini">
        <ui:Label text="LOG" class="logMiniTitle" />
        <ui:VisualElement class="logTrack"><ui:VisualElement name="logProgress" class="logProgress" /></ui:VisualElement>
        <ui:Label name="logProgressText" text="" class="logMiniText" />
        <ui:Label name="logWarnCount" text="" class="logMiniWarn" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="helpOverlay" class="helpOverlay">
      <ui:VisualElement class="helpPanel">
        <ui:VisualElement class="helpBar">
          <ui:Label text="HELP" class="helpTitle" />
          <ui:Label text="game paused · H, F1 or Esc closes" class="helpHint" />
          <ui:VisualElement class="logSpacer" />
          <ui:Button name="helpClose" text="CLOSE" class="smallButton" />
        </ui:VisualElement>
        <ui:ScrollView name="helpScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="helpScroll">
          <ui:Label text="GOAL" class="helpHead" />
          <ui:Label text="Drive real Norwegian roads, built from the map, as fast as you dare. On a route stage the clock runs from the end of the countdown to the finish line; hitting an animal or a person adds penalty seconds (red, next to the clock), a near miss takes one off. Crashes damage the car: a hurt engine loses power, a holed radiator overheats it, and a dead engine retires you." class="helpText" />
          <ui:Label text="DRIVING" class="helpHead" />
          <ui:VisualElement class="helpRow"><ui:Label text="" class="helpCell helpCellHead helpCol0" /><ui:Label text="KEYBOARD" class="helpCell helpCellHead helpCol1" /><ui:Label text="GAMEPAD" class="helpCell helpCellHead helpCol2" /><ui:Label text="TOUCH" class="helpCell helpCellHead helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Throttle" class="helpCell helpCol0" /><ui:Label text="W / Up" class="helpCell helpCol1" /><ui:Label text="right trigger" class="helpCell helpCol2" /><ui:Label text="GAS" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Brake, reverse (hold)" class="helpCell helpCol0" /><ui:Label text="S / Down" class="helpCell helpCol1" /><ui:Label text="left trigger" class="helpCell helpCol2" /><ui:Label text="BRAKE" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Steer" class="helpCell helpCol0" /><ui:Label text="A D / Left Right" class="helpCell helpCol1" /><ui:Label text="left stick" class="helpCell helpCol2" /><ui:Label text="LEFT / RIGHT" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Handbrake (drift)" class="helpCell helpCol0" /><ui:Label text="Shift" class="helpCell helpCol1" /><ui:Label text="B (east)" class="helpCell helpCol2" /><ui:Label text="DRIFT" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Jump" class="helpCell helpCol0" /><ui:Label text="Space" class="helpCell helpCol1" /><ui:Label text="A (south)" class="helpCell helpCol2" /><ui:Label text="-" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Gear up / down" class="helpCell helpCol0" /><ui:Label text="E / Q" class="helpCell helpCol1" /><ui:Label text="RB / LB" class="helpCell helpCol2" /><ui:Label text="-" class="helpCell helpCol3" /></ui:VisualElement>
          <ui:Label text="Q / E (or RB / LB) switch an automatic gearbox to manual for this visit (the gear shows M; on the limiter press E or G); G switches and is remembered. On the start screen: the car cards (click, or LEFT / RIGHT), START ENGINE (or Enter), GEARBOX, SLIDING (how easily the tail steps out, 0-3) and ROUTE MAP." class="helpText" />
          <ui:Label text="CARS" class="helpHead" />
          <ui:Label text="Pick your car on the start screen: click or tap a card, or LEFT / RIGHT (gamepad d-pad); ESC or the MENU button returns there from a stage to change it. The game remembers the choice, and friends in a room see the car you drive. Each car handles differently: Porsche 911 and 911 Carrera 3.2 (rear engine, light and lively), 911 Turbo (930, fastest on tarmac, the turbo wakes up late), Volvo 240 Turbo (heavy, soft, predictable), MV6 '83 Group B (four-wheel drive, short gears, huge power), Ford Ranger Offroad (heavy 4WD truck on long springs: slow on tarmac, climbs almost anything), Baja Bug (light buggy on big tyres, 100 km/h across open ground), Buggy Type 736 (small, slow and nimble). Every car reaches its real top speed on asphalt; gravel roads and tracks are limited to 120 km/h (slower cars stay a little under their asphalt top); the car counts as on the road while a wheel is on it. Off the road the road cars stop pulling at 45-50 km/h, the buggies and the Ranger go much faster. Houses, trees, sign posts, bridge rails and tunnel walls are solid: a car that starts or restarts on one is moved along the road to a free spot. Bridges and tunnels come from the map: roads run over bridge decks and through tunnels (lit by their lamps; the camera stays inside), avalanche galleries have a roof; stages may go through tunnels. Card stats: power, weight, driven wheels, gears." class="helpText" />
          <ui:Label text="GAME KEYS" class="helpHead" />
          <ui:VisualElement class="helpRow"><ui:Label text="H or F1" class="helpCell helpKey helpCol0" /><ui:Label text="this help (game paused)" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="C" class="helpCell helpKey helpCol0" /><ui:Label text="next camera - 1 overhead, 2 chase, 3 seat" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="R" class="helpCell helpKey helpCol0" /><ui:Label text="restart the stage" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="N" class="helpCell helpKey helpCol0" /><ui:Label text="new endless stage from where you are" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="G" class="helpCell helpKey helpCol0" /><ui:Label text="gearbox automatic / manual" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="M" class="helpCell helpKey helpCol0" /><ui:Label text="sound on / off" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="Esc or MENU" class="helpCell helpKey helpCol0" /><ui:Label text="back to the start screen from any point of a stage: change the car, gearbox, sliding, route or room, then START ENGINE restarts the stage (Esc closes the help or the map first)" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="MAP button" class="helpCell helpKey helpCol0" /><ui:Label text="pick a route on the map (web build)" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="F2 or LOG bar" class="helpCell helpKey helpCol0" /><ui:Label text="log window, minimised to the LOG bar at the top: its progress bar shows how much of the world is loaded (the start area while loading, then everything around the car), the warning count is in red; click it or F2 to open, X to minimise. collision: lines say what stopped the car" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:VisualElement class="helpRow"><ui:Label text="F10 or F3" class="helpCell helpKey helpCol0" /><ui:Label text="debug window (phones: tap the speed three times)" class="helpCell helpKey helpCol1" /></ui:VisualElement>
          <ui:Label text="ON SCREEN" class="helpHead" />
          <ui:Label text="Top left: stage time, penalty and distance to the finish. Top right: the pace note for the next turn - metres to it and its kind (EASY LEFT, HAIRPIN RIGHT ...). The yellow arrow on the road 15-30 m ahead shows the way: it follows the route round the next bend (in free drive the road you are on). The finish is a checkered banner over the road with a checkered line under it. Bottom: speed in km/h, gear (R = reverse), rev bar (red near the limiter), the surface under the car (ASPHALT, GRAVEL, OFF ROAD, WATER) and the red damage bar. Off road, and less on gravel, the wheels spin under full power: the revs jump, mud or stones fly and the car pulls a little less - ease the throttle for grip." class="helpText" />
          <ui:Label text="STAGES" class="helpHead" />
          <ui:Label text="Route stage: on the MAP, search a town or place name in the START and FINISH boxes (or click the map, start then finish); each pin snaps to the nearest road and the stage follows real roads to a finish time. Endless (N, or a ?seed= link): the road ahead keeps being picked as you drive, no finish. Free drive (a ?drive= link): any road, no clock. DRIVE WITH FRIENDS: HOST A ROOM and share the 4-letter code, the others JOIN; you race each other's ghosts (rooms go through the internet; phones cannot link over Bluetooth from a web page). Every stage is a link in the address bar you can share." class="helpText" />
          <ui:Label text="DATA" class="helpHead" />
          <ui:Label text="Terrain © Kartverket (CC BY 4.0) · forest SR16 © NIBIO (NLOD) · bioclimatic zones and sections (verge plants) Artsdatabanken / Miljødirektoratet (NLOD) · roads, buildings and water © OpenStreetMap contributors (ODbL) · road surfaces and road signs Statens vegvesen NVDB (NLOD) · borders geoBoundaries (CC BY 4.0). Made by Filip Tobias Moan © 2026." class="helpText" />
          <ui:Label text="CAR MODELS (CC BY 4.0, Sketchfab)" class="helpHead" />
          <ui:Label text="Porsche 911 by WoTiger (Philipp Busse) · Porsche 911 3.2 Carrera Coupe by cepela · Porsche 911 (930) Turbo 1975 by Lexyc16, improved by Wolf Hal (WolfGames36) · Volvo 240 styled sedan by Libau Media · Placeholder MV6 '83 by Daniel Zhabotinsky · Ford Ranger Offroad by CursedCrown · Off Road 4X4 racer (Baja Bug) by duanesmind · Buggy type 736 by Andre_rmntc. Scaled, re-rigged and recoloured for the game." class="helpText" />
        </ui:ScrollView>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="logWindow" class="logWindow">
      <ui:VisualElement class="logBar">
        <ui:Label text="LOG" class="logTitle" />
        <ui:Button name="logAll" text="ALL" class="logChip on" />
        <ui:Button name="logTiles" text="TILES" class="logChip" />
        <ui:Button name="logOverlays" text="OVERLAYS" class="logChip" />
        <ui:Button name="logCache" text="CACHE" class="logChip" />
        <ui:Button name="logWarn" text="WARN" class="logChip" />
        <ui:VisualElement class="logSpacer" />
        <ui:Button name="logFollow" text="FOLLOW" class="logChip on" />
        <ui:Button name="logCopy" text="COPY" class="logChip" />
        <ui:Button name="logClose" text="X" class="logChip" />
      </ui:VisualElement>
      <ui:ListView name="logList" class="logList" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
